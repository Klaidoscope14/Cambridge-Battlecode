+void Bot::ensure_arrival() {
+    if (arrive_ready || (Cfg::ARRIVAL_PEN >= 1.f && Cfg::ARRIVAL_THEM_PEN >= 1.f)) return;
+    arrive_ready = true;
+    bitboard visited;
+    enemy_field.compute(terrain & ~enemy_spawn, enemy_spawn, visited);
+    arrive_delta.assign(groups.size(), 999);
+    for (std::size_t i = 0; i < groups.size(); ++i) {
+        int du = UNREACH, dt = UNREACH;
+        for (auto t : groups[i].tiles) {
+            du = std::min<int>(du, spawn_field.get(t));
+            dt = std::min<int>(dt, enemy_field.get(t));
+        }
+        if (du < UNREACH && dt < UNREACH) arrive_delta[i] = du - dt;
     }

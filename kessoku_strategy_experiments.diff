+// --- strategy experiments (all off = v25/v26 behaviour) ---
+inline constexpr float ARRIVAL_PEN = 1.0f;       // opening: value multiplier for groups both teams reach about together
+inline constexpr float ARRIVAL_THEM_PEN = 1.0f;  // opening: multiplier for groups the enemy reaches clearly first
+inline constexpr int ARRIVAL_TIE = 3;            // |our spawn distance - their spawn distance| <= this = contested
+inline constexpr int ARRIVAL_ROUNDS = 300;       // rules apply this long
+inline constexpr bool LEAD_SAFE = false;         // while far ahead (standing > 0) keep applying the arrival rules: avoid contested groups
+inline constexpr bool DURABILITY_SLOT = false;   // buy a Durability emblem (-10% damage taken) after Monster + Jungle
+inline constexpr bool LOCK_ON_BANK = false;      // place our altar lock before tributing there (blocks enemy tribute and enemy locks)
+inline constexpr bool WARD_ON_CAPTURE = false;   // leave the ward on the group we just captured (respawn timer + enemy sightings stay visible)
+inline constexpr bool WARD_ON_BANK = false;      // leave the ward next to the altar we tribute at
+inline constexpr int CLOSEOUT_AT = 0;            // team tributed gems at which every body banks any bag >= CLOSEOUT_MIN_BAG
+inline constexpr int CLOSEOUT_MIN_BAG = 5;
 // Banking: go tribute once the bag is this big, or opportunistically when close.
